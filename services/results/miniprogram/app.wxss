page {
  --parent-accent: #e60012;
  --parent-text: #303030;
  --parent-muted: #767676;
  --parent-surface: #f5f5f5;
  background: #ffffff;
  color: var(--parent-text);
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei',
    sans-serif;
}
.page {
  padding: 36rpx 48rpx 70rpx;
  box-sizing: border-box;
  padding-bottom: calc(70rpx + env(safe-area-inset-bottom));
}
.brand-space {
  height: 100rpx;
  width: 100%;
}
.display-heading {
  font-family: 'Arial Rounded MT Bold', 'Arial Rounded MT', Arial, sans-serif;
  font-size: 82rpx;
  font-weight: 900;
  line-height: 0.98;
  letter-spacing: -3rpx;
  color: var(--parent-accent);
  overflow-wrap: break-word;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--parent-muted);
  margin-bottom: 24rpx;
}
.title {
  font-size: 38rpx;
  line-height: 1.5;
  font-weight: 600;
  letter-spacing: -1rpx;
}
.subtitle {
  font-size: 26rpx;
  color: var(--parent-muted);
  line-height: 1.9;
  margin-top: 20rpx;
}
.card {
  background: white;
  border: 1rpx solid #ededed;
  border-radius: 56rpx;
  padding: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.section-heading {
  font-size: 31rpx;
  font-weight: 600;
}
.notice {
  font-size: 23rpx;
  line-height: 1.8;
  background: #fcf7e6;
  border: 1rpx solid #e9dfbc;
  color: #8e7b41;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  margin-top: 28rpx;
}
.error {
  font-size: 24rpx;
  line-height: 1.8;
  color: #ae2331;
  background: #fff2f3;
  padding: 20rpx;
  margin-top: 22rpx;
  border-radius: 22rpx;
}
.primary-button {
  background: var(--parent-accent);
  color: white;
  border-radius: 999rpx;
  font-size: 29rpx;
  margin-top: 40rpx;
  line-height: 88rpx;
  min-height: 88rpx;
  font-weight: 600;
}
.primary-button[disabled] {
  background: #eeeeee;
  color: #888888;
}
.primary-button::after,
.text-button::after {
  border: none;
}
.text-button {
  background: transparent;
  color: var(--parent-muted);
  font-size: 25rpx;
  margin: 28rpx auto 0;
}
.fixed-image {
  width: 100%;
  display: block;
  border-radius: 16rpx;
  margin-top: 24rpx;
}
