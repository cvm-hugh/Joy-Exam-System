<view class="result-page">
  <swiper wx:if="result" class="result-swiper" indicator-dots="true" indicator-color="#c7d1cb" indicator-active-color="#23664f" duration="320" bindchange="onSlideChange">
    <swiper-item><view class="slide student-slide"><view class="slide-count">{{current + 1}} / {{pageCount}}</view><view class="brand-space" aria-hidden="true"></view><view class="student-avatar"><view class="avatar-hair"></view><view class="avatar-face"><view class="avatar-eye left"></view><view class="avatar-eye right"></view><view class="avatar-smile"></view></view></view><view class="student-name">{{result.name}}</view><view class="student-branch">{{result.branch}}</view><view class="student-branch-en">{{result.branch}} Branch School</view></view></swiper-item>
    <swiper-item wx:if="result.admission"><view class="slide admission-slide {{result.admission.qualifiedForInterview ? 'admission-positive' : 'admission-course'}}"><view class="slide-count">{{current + 1}} / {{pageCount}}</view><view class="brand-space"></view><view class="admission-mark">{{result.admission.qualifiedForInterview ? '✦' : '✓'}}</view><view class="admission-kicker">EXAMINATION RESULT</view><view class="admission-message">{{result.admission.message}}</view><view wx:if="result.admission.note" class="admission-note">{{result.admission.note}}</view></view></swiper-item>
    <swiper-item><view class="slide overview-slide"><view class="slide-count">{{current + 1}} / {{pageCount}}</view><view class="brand-space" aria-hidden="true"></view><image wx:if="result.headerImage" src="{{result.headerImage}}" class="overview-image" mode="aspectFit"/><view class="display-heading ability-heading">{{result.pageCopy.abilityHeading}}</view><view class="description">{{result.examInfo}}</view><radar-chart dimensions="{{result.dimensions}}" compact="{{true}}"/><view class="chart-note">得分系数 = 维度得分 ÷ 维度总分</view></view></swiper-item>
    <swiper-item wx:for="{{result.dimensions}}" wx:key="id" wx:for-item="dimension"><view class="slide dimension-slide"><view class="slide-count">{{current + 1}} / {{pageCount}}</view><view class="dimension-top"><view><view class="dimension-number">0{{index + 1}}</view><view class="dimension-name">{{dimension.name}}</view></view><view class="grade">{{dimension.grade}}</view></view><view class="coefficient">得分系数 {{dimension.coefficient}}</view><view class="analysis-block"><view class="paragraph-title">{{result.paragraphTitles[0]}}</view><view class="grade-description-list"><view wx:for="{{dimension.gradeDescriptions}}" wx:key="grade" wx:for-item="level" class="grade-description-row {{level.selected ? 'is-current' : ''}}"><view class="grade-description-check">{{level.selected ? '✓' : ''}}</view><view class="grade-description-content"><text class="grade-description-name">{{level.grade}}</text><text user-select="true">{{level.description}}</text></view></view></view></view><view class="advice-grid"><view><view class="paragraph-title">{{result.paragraphTitles[1]}}</view><text user-select="true">{{dimension.evaluation.paragraphs[1]}}</text></view><view><view class="paragraph-title">{{result.paragraphTitles[2]}}</view><text user-select="true">{{dimension.evaluation.paragraphs[2]}}</text></view></view><image wx:if="dimension.evaluation.image" src="{{dimension.evaluation.image}}" class="evaluation-image" mode="aspectFit"/></view></swiper-item>
    <swiper-item wx:if="result.coverBackgroundImage || result.coverQrImage || result.coverText || result.coverFooter"><view class="slide back-cover"><view class="slide-count cover-count">{{current + 1}} / {{pageCount}}</view><image wx:if="result.coverBackgroundImage" class="back-cover-background" src="{{result.coverBackgroundImage}}" mode="aspectFill"/><view class="back-cover-center"><image wx:if="result.coverQrImage" class="back-cover-qr" src="{{result.coverQrImage}}" mode="aspectFit"/><view wx:if="result.coverText" class="back-cover-text">{{result.coverText}}</view></view><view wx:if="result.coverFooter" class="back-cover-footer">{{result.coverFooter}}</view></view></swiper-item>
  </swiper>
  <view wx:elif="error" class="error">{{error}}</view><view wx:else class="subtitle">正在核对查询状态…</view><button class="text-button result-back" bindtap="back">返回查询</button>
</view>
