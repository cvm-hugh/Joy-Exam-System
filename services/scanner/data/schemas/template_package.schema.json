{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "答题卡模板包",
  "type": "object",
  "required": ["schema_version", "template_id", "name", "version", "status", "answer_schema", "scoring"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "template_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "testing", "approved", "retired"]},
    "answer_schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "label", "choices", "score_section"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "choices": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "score_section": {"type": "string", "minLength": 1}
        }
      }
    },
    "scoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "label", "maximum"],
        "properties": {
          "section_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "maximum": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
